# ---------------------------------------------------------------------------
# AutoDev configuration
# Copy to .env and fill in what you need. Nothing here is required to start in
# demo mode. Values are read by the backend only; never commit a real .env.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
# Optional bearer token. When set, every /api route except /api/health requires
# `Authorization: Bearer <token>` (the UI asks for it on the Settings page and
# keeps it in localStorage only).
AUTODEV_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Database -------------------------------------------------------------
# SQLite for local development. The Docker setup uses sqlite:////data/autodev.db
DATABASE_URL=sqlite:///./autodev.db

# --- GitHub ---------------------------------------------------------------
# Classic PAT with `repo` scope, or fine-grained token with:
#   Metadata: read, Contents: read/write, Issues: read, Pull requests: read/write
# Prefer a GitHub App in production (see README "GitHub integration").
GITHUB_TOKEN=
# Optional GitHub App authentication (all three required together):
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_API_URL=https://api.github.com
# Optional override for the base branch used for pull requests.
GITHUB_DEFAULT_BASE_BRANCH=

# --- AI provider ----------------------------------------------------------
# auto   -> use OpenAI-compatible provider if AI_API_KEY is set, else demo mode
# openai -> require a key (startup warns if missing and runs in demo mode)
# demo   -> always use the deterministic fixture provider
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_CHARS=60000
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096

# --- Agent ----------------------------------------------------------------
AGENT_MAX_CORRECTION_ATTEMPTS=2
AGENT_EXECUTION_TIMEOUT=600
AGENT_TEST_TIMEOUT=180
AGENT_MAX_FILES_MODIFIED=10
AGENT_MAX_CONCURRENT_TASKS=2
REQUIRE_PLAN_APPROVAL=true
REQUIRE_PR_APPROVAL=true

# --- Sandbox --------------------------------------------------------------
# local  -> run tests on this machine with an allowlist, scrubbed env, limits
# docker -> send commands to the isolated worker service (recommended)
SANDBOX_MODE=local
SANDBOX_URL=http://127.0.0.1:8010
SANDBOX_TOKEN=change-me-sandbox-token
# Bare executable names separated by commas. Shell interpreters and inline eval
# are always rejected, regardless of this list.
ALLOWED_COMMANDS=python,python3,pytest,npm,node,yarn,pnpm,ruff,tsc,go,cargo

# --- Paths ----------------------------------------------------------------
WORKSPACE_DIR=./data/workspaces
DEMO_REPO_DIR=./backend/demo_repo

# --- Frontend (Vite, build time) -----------------------------------------
# Leave empty when the UI is served through the Vite proxy / nginx proxy.
VITE_API_URL=

# --- Docker Compose -------------------------------------------------------
# Only used by docker-compose.yml
AUTODEV_DATA_DIR=./data
